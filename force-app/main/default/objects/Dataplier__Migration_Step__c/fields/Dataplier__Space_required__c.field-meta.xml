    <externalId>false</externalId>
    <formula>CASE(Dataplier__Object_Name__c, &apos;Campaigns&apos; , 8, &apos;CampaignMember&apos; , 1, &apos;Articles&apos;, 4, 2) * Dataplier__Total__c</formula>
