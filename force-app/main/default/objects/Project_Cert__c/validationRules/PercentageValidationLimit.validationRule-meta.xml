<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PercentageValidationLimit</fullName>
    <active>true</active>
    <errorConditionFormula>Progress__c  &gt; 1.00</errorConditionFormula>
    <errorMessage>Cannot add progress larger than 100%</errorMessage>
</ValidationRule>
